    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
